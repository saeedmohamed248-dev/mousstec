# ==============================================================
# 🚀 قالب متغيرات الإنتاج — انسخه لـ .env على السيرفر واملأ القيم
#   cp .env.production.example .env  ثم عدّل القيم
# ==============================================================

# --- أساسيات Django ---
DEBUG=False
# ولّد مفتاحاً عشوائياً طويلاً (50+ حرف). مثال لتوليده:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=ضع-هنا-مفتاحاً-عشوائياً-طويلاً-جداً

# دومينك الأساسي (بدون https). سَبدومينات الفروع تشتغل تلقائياً تحته.
BASE_DOMAIN=example.com
# إيميلك — Caddy بيستخدمه لإصدار شهادات HTTPS المجانية
ACME_EMAIL=you@example.com
# لازم يفضل "web" هنا (عشان فحص شهادات الفروع الداخلي). ضيف IP السيرفر لو حبيت تختبر بيه.
EXTRA_ALLOWED_HOSTS=web

# --- قاعدة البيانات (لازم تتطابق قيم POSTGRES_* مع DATABASE_URL) ---
POSTGRES_DB=erp_db
POSTGRES_USER=erp
POSTGRES_PASSWORD=غيّر-دي-لكلمة-سر-قوية
DATABASE_URL=postgres://erp:غيّر-دي-لكلمة-سر-قوية@db:5432/erp_db

# --- Redis + Celery (متسبهاش زي ما هي، أسماء الخدمات الداخلية) ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- تخزين الميديا ---
# False = صور القطع تتخزن على قرص السيرفر (volume). خليها False للبساطة في البداية.
# True = استخدام DigitalOcean Spaces / S3 (املأ مفاتيح AWS_* حينها).
USE_S3=False

# --- الذكاء الاصطناعي ---
# ⚠️ خليها False لحد ما تحط مفتاح Gemini — لو True والمفتاح فاضي البرنامج مش هيشتغل.
ENABLE_AI_PREDICTIONS=False
AI_VISION_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=

# --- ربط موقع FixIt (اختياري) ---
FIXIT_SYNC_URL=
FIXIT_SYNC_SECRET=
FIXIT_BRANCH_ID=1

# --- بوابة الدفع Paymob (اختياري) ---
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
