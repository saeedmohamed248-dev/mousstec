; «مخ موس» — copy this file to brain.ini (next to the brain folder) and fill it in.
; brain.ini holds the device token: don't send it to anyone or put it on GitHub.

[server]
api_base = https://YOUR-WORKSHOP.mousstec.com/api/robot/v1
token    = PASTE_DEVICE_TOKEN_FROM_ADMIN

[audio]
mic     =          ; empty = the computer's default. Or a number / part of the name
speaker =          ;   from: python -m brain devices   (e.g. mic = USB)
volume  = 1.0

[ears]
model        = small   ; small · medium · large-v3-turbo — run: python -m brain bench
language     = ar      ; ar, or auto (Arabic and English mixed)
device       = auto    ; cpu · cuda (an NVIDIA card) · auto
compute_type = int8
beam_size    = 1       ; 1 = fastest, 5 = a little more accurate

[robot]
name = موس             ; the name it answers to: «يا موس»

[listen]
min_start      = 150   ; listening starts above this (and above 3.5 × the room)
max_start      = 2500
end_silence_ms = 600   ; a pause this long ends the sentence
