# =====================================================================
# Mouss Tec ERP — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =====================================================================

# ── Core Django ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=False
BASE_DOMAIN=mousstec.com
ADMIN_URL=secure-portal
# Force HTTPS at the application layer when behind a TLS-terminating proxy.
# Leave True in production. Set to False only for local TLS-less debugging.
SECURE_SSL_REDIRECT=True

# ── Database & Cache ────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/mousstec
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS / CSRF (comma-separated) ───────────────────────────────────
CORS_ALLOWED_ORIGINS=https://mousstec.com,https://www.mousstec.com
CSRF_TRUSTED_ORIGINS=https://mousstec.com,https://*.mousstec.com

# ── Email ───────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mouss Tec <noreply@mousstec.com>
SUPPORT_INBOX_EMAIL=support@mousstec.com

# ── Paymob Payment Gateway ──────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ── Shopify Webhook (HMAC) ──────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=

# ── WhatsApp Business API (OTP delivery) ────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_login
OTP_DELIVERY_PROVIDER=whatsapp
MARKETPLACE_DEBUG_OTP=False

# ── AI Providers ────────────────────────────────────────────────────
TOGETHER_API_KEY=
TOGETHER_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
GEMINI_API_KEY=
IDEOGRAM_API_KEY=
AI_VISION_API_KEY=
FLUX_MODEL_PROVIDER=together

# ── Feature flags ───────────────────────────────────────────────────
DESIGN_CHAT_ENABLED=True
DESIGN_QUALITY_GATE_ENABLED=True
ENABLE_AI_PREDICTIONS=True

# ── External catalogs ───────────────────────────────────────────────
TECDOC_API_KEY=
ALLDATA_ENDPOINT=

# ── AWS S3 (optional, for media storage) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# ── Sentry ──────────────────────────────────────────────────────────
SENTRY_DSN=

# =====================================================================
# BMW / MINI ECU — Used-DME (Engine Swap) ISN alignment
# =====================================================================
# SAFETY POLICY: Mouss Tec never guesses against live hardware. Every
# address / DID / security level below is per-platform and MUST be the
# value YOU confirmed from your ZGW / CAS3(+) / MEVD17 documentation or a
# known-good dump. Leave a value blank and the system REFUSES that step
# (honest 503) instead of inventing one. Hex ("0x40") or decimal both work.
# ---------------------------------------------------------------------

# ── Mode switch ─────────────────────────────────────────────────────
# 1 = dry-run against the in-memory simulator (no hardware, full wizard).
# Unset / 0 = live hardware; the confirmed addresses below become required.
BMW_ECU_SIMULATOR=0
# Set 1 in production to HARD-LOCK the simulator off (belt & suspenders):
# even BMW_ECU_SIMULATOR=1 is ignored, so a real car can never hit a Mock.
BMW_ECU_REQUIRE_HARDWARE=0
# Where encrypted DME/EEPROM backups are written before any ISN write.
BMW_ECU_BACKUP_ROOT=/Users/saied/ERP_System/.ecu_backups

# ── Transport: K-Line bridge through the pre-2007 E-series gateway ───
# The FTDI serial device your K-Line/FTDI cable enumerates as.
BMW_ECU_KLINE_PORT=/dev/cu.usbserial-XXXXXXXX
# KWP diagnostic address of the GATEWAY (ZGW/CAS on pin 7) that bridges
# the OBD frames onto PT-CAN. This is the bridge, NOT the DME.
BMW_ECU_KLINE_TARGET=0x00

# ── E-series diagnostic addresses (REQUIRED for a live run) ─────────-
# Diagnostic address of the CAS3 / CAS3+ immobilizer.
BMW_ECU_SWAP_CAS_ADDR=0x00
# Diagnostic address of the MEVD17 / target DME.
BMW_ECU_SWAP_DME_ADDR=0x12

# ── CAS ISN read spec (confirmed) ───────────────────────────────────
# ReadDataByIdentifier DID that returns the 32-byte ISN from the CAS,
# plus the SecurityAccess level that unlocks it. Both required together
# to read a real ISN; leave blank and the CAS read step refuses.
BMW_ECU_SWAP_CAS_ISN_DID=
BMW_ECU_SWAP_CAS_ISN_LEVEL=

# ── DME ISN write spec — Phase 1 (UDS) (optional) ───────────────────
# WriteDataByIdentifier DID + level for the direct UDS ISN write.
# Provide BOTH to attempt the clean UDS write first. Omit either one and
# Phase 1 is skipped — the pipeline diverts straight to the TriCore BSL
# fallback wizard (Bosch MEVD17 only; Siemens halts to bench/BDM).
BMW_ECU_SWAP_DME_ISN_DID=
BMW_ECU_SWAP_DME_ISN_LEVEL=

# ── EWS alignment (confirmed) ───────────────────────────────────────
# RoutineControl ID for the E-series CAS<->DME EWS-sync routine.
BMW_ECU_SWAP_EWS_ROUTINE=

# ── Safety override ─────────────────────────────────────────────────
# Set 1 ONLY once the DID/level values above are the REAL confirmed ones.
# This opt-in tells the extractor to trust an operator-supplied spec and
# actually run it against the car. Keep 0 until you are certain.
BMW_ECU_SWAP_ALLOW_UNVERIFIED=0

# ── BSL fallback (Phase 2 — no external programmer) ─────────────────-
# FTDI serial device wired STRAIGHT to the DME board's boot pad for
# TriCore Bootstrap-Loader access. Defaults to BMW_ECU_KLINE_PORT if unset.
BMW_ECU_SWAP_BSL_PORT=

# ── Facebook Messenger Bot (Meta) ───────────────────────────────────
# App Secret from Meta App Dashboard → Settings → Basic. Enables
# X-Hub-Signature-256 verification on the webhook POST. Leave empty
# only in dev — unset means the webhook accepts unsigned payloads.
FB_APP_SECRET=

# ── Marketplace OTP (phone-ownership verification) ──────────────────
# Turn on ONLY after OTP_DELIVERY_PROVIDER is set to a working provider
# (twilio / vonage / whatsapp_meta / email). With 'console' the codes go
# to the log only and real users cannot receive them.
MARKETPLACE_OTP_REQUIRED=0

# ── Subscription auto-renewal (saved cards / Paymob tokenization) ───
# Requires: PAYMOB integration with MOTO/token payments enabled, and the
# TOKEN webhook delivered to /payment/paymob/callback/. Cards are saved
# when the customer ticks "save card" in the Paymob iframe; renewal only
# charges cards whose owner enabled auto_renew (opt-in per card).
AUTO_RENEW_ENABLED=0

# ── ETA e-Invoicing (منظومة الفاتورة الإلكترونية المصرية) ───────────
# Register at https://invoicing.eta.gov.eg (prod) or preprod portal.
# Needed before enabling: ERP client credentials, taxpayer RIN, activity
# code, EGS item-code approval, and an ITIDA e-seal device for signing.
ETA_EINVOICE_ENABLED=0
ETA_ENVIRONMENT=preprod
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ISSUER_RIN=
ETA_ISSUER_NAME=
ETA_ISSUER_ACTIVITY_CODE=
ETA_ISSUER_GOVERNATE=Cairo
ETA_ISSUER_CITY=Cairo
ETA_ISSUER_STREET=
ETA_ISSUER_BUILDING=0
# python path 'module:function' that CAdES-BES-signs the document dict
ETA_SIGNATURE_HOOK=
# preprod testing only — never 1 in production
ETA_ALLOW_UNSIGNED=0

# ── Web Push notifications (VAPID) ──────────────────────────────────
# Generate once:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); \
#     print('PRIVATE:', v.private_pem().decode()); \
#     print('PUBLIC :', v.public_key_urlsafe_base64())"
# Empty keys = push disabled everywhere (endpoints return {enabled:false}).
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_ADMIN_EMAIL=admin@mousstec.com

# ── Multi-currency (display layer; ledger stays EGP) ────────────────
# HMAC secret for the forex webhook /system/webhooks/regional/tax-forex-sync/.
# Provider POSTs {"base":"EGP","rates":{"USD":0.0203,...}} signed with
# X-Forex-HMAC-SHA256. Empty = webhook rejects (fail-closed).
FOREX_WEBHOOK_SECRET=
# Optional daily pull (alternative to webhook push). Empty = disabled.
FOREX_FETCH_URL=
FOREX_FETCH_API_KEY=

# ── Disaster recovery (nightly DB backup via pg_dump) ───────────────
# Requires postgresql-client (pg_dump) on the host. Off by default so it
# never fails on environments without it. Backups land in BASE_DIR/backups
# (and S3 when USE_S3=1). Restore: gunzip -c file.sql.gz | psql "$DATABASE_URL"
DB_BACKUP_ENABLED=0
DB_BACKUP_RETENTION_DAYS=14

# ── Wix integration (e-commerce sync) ───────────────────────────────
# No global keys — each tenant's Wix API Key + Site ID are entered per
# company from the super-admin page (/superadmin/wix/). Get the API key
# at manage.wix.com → Account Settings → API Keys, and the Site ID from
# the site dashboard. The real-time order webhook is /api/webhooks/wix/orders/.
