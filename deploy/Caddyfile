# 🔒 Caddy — HTTPS تلقائي (Let's Encrypt) + دعم سَبدومينات الفروع (on-demand)
{
	email {$ACME_EMAIL}
	# شهادات تلقائية لسَبدومينات الفروع عند أول زيارة، بعد التحقق من قاعدة البيانات
	on_demand_tls {
		ask http://web:8000/internal/tls-check/
	}
}

# الدومين الرئيسي
{$BASE_DOMAIN} {
	encode zstd gzip
	# صور القطع والمستندات تُخدم مباشرة من قرص السيرفر (أسرع)
	# 🔒 الملفات الخاصة (كشوف بنك، وشوش موظفين، ملفات مستوردة...) بتعدّي على Django
	#    (تسجيل دخول + الشركة صاحبة الملف + الدور) — erp_core/private_media.py
	route /media/* {
		@private_media path /media/bank_statements/* /media/imports/* /media/customs_docs/* /media/signatures/* /media/hr/faces/* /media/manual_payments/*
		reverse_proxy @private_media web:8000
		# ملف HTML/SVG مرفوع كان بيتعرض كصفحة من دومين الموقع (كود يشتغل باسم الموقع) —
		# بيتنزّل كملف ومن غير سكريبتات. الصور وملفات PDF زي ما هي.
		@active_media path *.html *.htm *.xhtml *.svg *.svgz *.xml *.js *.mjs
		header @active_media Content-Disposition attachment
		header @active_media Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		uri strip_prefix /media
		root * /srv/media
		file_server
	}
	reverse_proxy web:8000
}

# كل سَبدومينات الفروع (tenant1.example.com ...)
*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	encode zstd gzip
	# 🔒 الملفات الخاصة (كشوف بنك، وشوش موظفين، ملفات مستوردة...) بتعدّي على Django
	#    (تسجيل دخول + الشركة صاحبة الملف + الدور) — erp_core/private_media.py
	route /media/* {
		@private_media path /media/bank_statements/* /media/imports/* /media/customs_docs/* /media/signatures/* /media/hr/faces/* /media/manual_payments/*
		reverse_proxy @private_media web:8000
		# ملف HTML/SVG مرفوع كان بيتعرض كصفحة من دومين الموقع (كود يشتغل باسم الموقع) —
		# بيتنزّل كملف ومن غير سكريبتات. الصور وملفات PDF زي ما هي.
		@active_media path *.html *.htm *.xhtml *.svg *.svgz *.xml *.js *.mjs
		header @active_media Content-Disposition attachment
		header @active_media Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		uri strip_prefix /media
		root * /srv/media
		file_server
	}
	reverse_proxy web:8000
}
