# 🔒 Caddy — HTTPS تلقائي (Let's Encrypt) + دعم سَبدومينات الفروع (on-demand)
{
	email {$ACME_EMAIL}
	# شهادات تلقائية لسَبدومينات الفروع عند أول زيارة، بعد التحقق من قاعدة البيانات
	on_demand_tls {
		ask http://web:8000/internal/tls-check/
	}
}

# 🧑‍🤝‍🧑 نسخ الويب (docker-compose: web.deploy.replicas) — Caddy بيسأل Docker DNS كل ٥ ثواني عن كل
#    النسخ الشغالة ويوزّع عليهم. لو نسخة وقفت (restart/نشر/عطل) الطلب بيتعاد على نسخة تانية
#    لحد ١٥ ثانية بدل ما الزائر يشوف خطأ، والنسخة اللي مابتردش بتتشال من التوزيع ١٠ ثواني.
(web_upstreams) {
	dynamic a {
		name web
		port 8000
		refresh 5s
	}
	lb_policy round_robin
	lb_try_duration 15s
	lb_try_interval 250ms
	fail_duration 10s
}

# الدومين الرئيسي
{$BASE_DOMAIN} {
	encode zstd gzip
	# صور القطع والمستندات تُخدم مباشرة من قرص السيرفر (أسرع)
	# 🔒 الملفات الخاصة (كشوف بنك، وشوش موظفين، ملفات مستوردة...) بتعدّي على Django
	#    (تسجيل دخول + الشركة صاحبة الملف + الدور) — erp_core/private_media.py
	route /media/* {
		@private_media path /media/bank_statements/* /media/imports/* /media/customs_docs/* /media/signatures/* /media/hr/faces/* /media/manual_payments/* /media/print_projects/* /media/print_jobs/*
		reverse_proxy @private_media {
			import web_upstreams
		}
		# ملف HTML/SVG مرفوع كان بيتعرض كصفحة من دومين الموقع (كود يشتغل باسم الموقع) —
		# بيتنزّل كملف ومن غير سكريبتات. الصور وملفات PDF زي ما هي.
		@active_media path *.html *.htm *.xhtml *.svg *.svgz *.xml *.js *.mjs
		header @active_media Content-Disposition attachment
		header @active_media Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		uri strip_prefix /media
		root * /srv/media
		file_server
	}
	reverse_proxy {
		import web_upstreams
	}
}

# كل سَبدومينات الفروع (tenant1.example.com ...)
*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	encode zstd gzip
	# 🔒 الملفات الخاصة (كشوف بنك، وشوش موظفين، ملفات مستوردة...) بتعدّي على Django
	#    (تسجيل دخول + الشركة صاحبة الملف + الدور) — erp_core/private_media.py
	route /media/* {
		@private_media path /media/bank_statements/* /media/imports/* /media/customs_docs/* /media/signatures/* /media/hr/faces/* /media/manual_payments/* /media/print_projects/* /media/print_jobs/*
		reverse_proxy @private_media {
			import web_upstreams
		}
		# ملف HTML/SVG مرفوع كان بيتعرض كصفحة من دومين الموقع (كود يشتغل باسم الموقع) —
		# بيتنزّل كملف ومن غير سكريبتات. الصور وملفات PDF زي ما هي.
		@active_media path *.html *.htm *.xhtml *.svg *.svgz *.xml *.js *.mjs
		header @active_media Content-Disposition attachment
		header @active_media Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		uri strip_prefix /media
		root * /srv/media
		file_server
	}
	reverse_proxy {
		import web_upstreams
	}
}
